# =============================================================================
# Admin POS - Environment Configuration
# =============================================================================
# Copy this file to .env for local development
# Most variables are inherited from root .env.example
# =============================================================================

# -----------------------------------------------------------------------------
# API Configuration
# -----------------------------------------------------------------------------
# API Gateway URL (Spring Boot - Port 8080)
VITE_API_GATEWAY_URL=http://localhost:8080

# API Base URL (for backward compatibility)
VITE_API_URL=http://localhost:8080

# WebSocket URL for real-time order updates
VITE_WS_URL=ws://localhost:8080/ws

# Assets/Images Base URL
VITE_ASSETS_URL=http://localhost:9000/product-images

# -----------------------------------------------------------------------------
# Application Configuration
# -----------------------------------------------------------------------------
VITE_APP_TITLE=Garbaking Admin POS
VITE_ENV=development

# -----------------------------------------------------------------------------
# Admin POS Specific Settings
# -----------------------------------------------------------------------------
# POS Mode (admin, staff)
VITE_POS_MODE=admin

# Session timeout in milliseconds (default: 1 hour)
VITE_SESSION_TIMEOUT=3600000

# -----------------------------------------------------------------------------
# Store Configuration
# -----------------------------------------------------------------------------
VITE_STORE_ID=store_001
VITE_STORE_NAME=Garbaking Restaurant
VITE_CURRENCY=FCFA
VITE_TAX_RATE=0.10

# -----------------------------------------------------------------------------
# Feature Flags
# -----------------------------------------------------------------------------
VITE_ENABLE_OFFLINE=true
VITE_ENABLE_MOCK_DATA=true
VITE_ENABLE_ANALYTICS=true
VITE_ENABLE_NOTIFICATIONS=true
VITE_ENABLE_PWA=true
VITE_ENABLE_DEVTOOLS=true

# -----------------------------------------------------------------------------
# Pagination
# -----------------------------------------------------------------------------
VITE_PAGE_SIZE=20
VITE_MAX_PAGE_SIZE=100

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------
VITE_LOG_LEVEL=debug
VITE_LOG_API_REQUESTS=true

# -----------------------------------------------------------------------------
# Production Overrides (Example)
# -----------------------------------------------------------------------------
# For production:
# VITE_API_GATEWAY_URL=https://api.garbaking.com
# VITE_WS_URL=wss://api.garbaking.com/ws
# VITE_ASSETS_URL=https://cdn.garbaking.com/images
# VITE_ENV=production
# VITE_ENABLE_MOCK_DATA=false
# VITE_ENABLE_DEVTOOLS=false
# VITE_LOG_LEVEL=error
