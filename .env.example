# =============================================================================
# Garbaking POS - Environment Configuration
# =============================================================================
# This file contains all environment variables for the Garbaking POS system.
# Copy this file to .env and update the values for your environment.
#
# IMPORTANT: Never commit .env files with sensitive data to version control!
# =============================================================================

# -----------------------------------------------------------------------------
# Backend Database Configuration
# -----------------------------------------------------------------------------
DB_USER=root
DB_PASSWORD=rootpassword

# -----------------------------------------------------------------------------
# Security Configuration
# -----------------------------------------------------------------------------
# JWT Secret (IMPORTANT: Change in production!)
# Must be at least 32 characters for HS256
JWT_SECRET=your-256-bit-secret-key-for-jwt-signing-change-this-in-production

# QR Payment Token Secret
QR_TOKEN_SECRET=garbaking-qr-payment-secret-key-change-in-production-min-32-chars

# Image Upload Signing Secret
IMAGE_SIGNING_SECRET=change-me-in-production-use-strong-secret-key

# -----------------------------------------------------------------------------
# MinIO Object Storage Configuration
# -----------------------------------------------------------------------------
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_BUCKET_NAME=product-images
MINIO_BASE_URL=http://localhost:9000/product-images

# -----------------------------------------------------------------------------
# Frontend API Configuration
# -----------------------------------------------------------------------------
# API Gateway URL (Spring Boot - Port 8080)
VITE_API_GATEWAY_URL=http://localhost:8080

# Legacy API URL (for backward compatibility with old backend)
VITE_API_URL=http://localhost:8080

# WebSocket URL for real-time order updates
VITE_WS_URL=ws://localhost:8080/ws

# Assets/Images Base URL
VITE_ASSETS_URL=http://localhost:9000/product-images

# -----------------------------------------------------------------------------
# Application Configuration
# -----------------------------------------------------------------------------
# Application Title
VITE_APP_TITLE=Garbaking POS

# Application Version
VITE_APP_VERSION=1.0.0

# Environment (development, staging, production)
VITE_ENV=development

# -----------------------------------------------------------------------------
# Feature Flags
# -----------------------------------------------------------------------------
# Enable/Disable Features
VITE_ENABLE_OFFLINE=true
VITE_ENABLE_MOCK_DATA=true
VITE_ENABLE_ANALYTICS=true
VITE_ENABLE_NOTIFICATIONS=true
VITE_ENABLE_PWA=true
VITE_ENABLE_DEVTOOLS=true

# -----------------------------------------------------------------------------
# Store Configuration
# -----------------------------------------------------------------------------
# Store Identification
VITE_STORE_ID=store_001
VITE_STORE_NAME=Garbaking Restaurant

# Currency and Pricing
VITE_CURRENCY=FCFA
VITE_TAX_RATE=0.10

# -----------------------------------------------------------------------------
# Logging and Debugging
# -----------------------------------------------------------------------------
# Log Level (debug, info, warn, error)
VITE_LOG_LEVEL=debug

# -----------------------------------------------------------------------------
# Kiosk-Specific Configuration
# -----------------------------------------------------------------------------
# Default language for kiosk (en, fr, ar)
VITE_DEFAULT_LANGUAGE=en

# Idle timeout in seconds before session reset
VITE_IDLE_TIMEOUT=60

# Kiosk mode (fullscreen, windowed)
VITE_KIOSK_MODE=fullscreen

# -----------------------------------------------------------------------------
# Admin POS Configuration
# -----------------------------------------------------------------------------
# POS Mode (admin, staff)
VITE_POS_MODE=admin

# Session timeout in milliseconds (default: 1 hour)
VITE_SESSION_TIMEOUT=3600000

# -----------------------------------------------------------------------------
# Pagination and Limits
# -----------------------------------------------------------------------------
# Default page size for listings
VITE_PAGE_SIZE=20

# Maximum page size allowed
VITE_MAX_PAGE_SIZE=100

# -----------------------------------------------------------------------------
# Payment Configuration
# -----------------------------------------------------------------------------
# Payment gateway endpoints
VITE_PAYMENT_GATEWAY_URL=http://localhost:8080/api/payments

# Supported payment methods (comma-separated)
VITE_PAYMENT_METHODS=cash,card,mobile_money,qr_code

# -----------------------------------------------------------------------------
# Kitchen Display System (KDS) Configuration
# -----------------------------------------------------------------------------
# KDS WebSocket for real-time order updates
VITE_KDS_WS_URL=ws://localhost:8080/ws/kitchen

# Auto-refresh interval in seconds
VITE_KDS_REFRESH_INTERVAL=30

# Sound alerts enabled
VITE_KDS_SOUND_ALERTS=true

# -----------------------------------------------------------------------------
# Customer App Configuration
# -----------------------------------------------------------------------------
# Customer app API base URL
VITE_CUSTOMER_API_URL=http://localhost:8080/api

# Enable customer loyalty features
VITE_ENABLE_LOYALTY=true

# Enable customer reviews
VITE_ENABLE_REVIEWS=true

# -----------------------------------------------------------------------------
# Development Tools
# -----------------------------------------------------------------------------
# Enable Vue DevTools in production
VITE_DEVTOOLS_PRODUCTION=false

# API request timeout in milliseconds
VITE_API_TIMEOUT=30000

# Enable request logging
VITE_LOG_API_REQUESTS=true

# -----------------------------------------------------------------------------
# Production Overrides (Example)
# -----------------------------------------------------------------------------
# For production, override these values:
# VITE_API_GATEWAY_URL=https://api.garbaking.com
# VITE_WS_URL=wss://api.garbaking.com/ws
# VITE_ASSETS_URL=https://cdn.garbaking.com/images
# VITE_ENV=production
# VITE_ENABLE_MOCK_DATA=false
# VITE_ENABLE_DEVTOOLS=false
# VITE_LOG_LEVEL=error
# JWT_SECRET=[Use strong secret from secrets manager]
# QR_TOKEN_SECRET=[Use strong secret from secrets manager]
# =============================================================================
